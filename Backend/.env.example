# Render & Supabase Environment Template for Spring Boot
PORT=8080

# Supabase PostgreSQL Connection
# (From Supabase -> Project Settings -> Database -> URI -> Transaction or Session pooler)
DATABASE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD

# Security JWT Secret (min 32 chars)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Origins (Include your deployed Netlify domain)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.netlify.app

# Optional Gmail SMTP for password reset OTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password

